{
  "uid": "predictops",
  "title": "PredictOps",
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Hosts predicted to fail",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT countIf(a = 1) FROM (SELECT host, argMax(alert, ts) AS a FROM predictions WHERE ts > now() - 12 GROUP BY host)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Hosts whose latest risk score is above the model's tuned alert threshold.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Failures in range",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT count() FROM incidents WHERE $__timeFilter(ts)"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Failures warned 30+ min ahead",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT if(count() = 0, NULL, countIf(lead >= 30) / count()) FROM (\n  SELECT i.ts, i.host, if(countIf(p.alert = 1 AND p.ts BETWEEN greatest(i.ts - 600, i.prev) AND i.ts) = 0, NULL, dateDiff('second', minIf(p.ts, p.alert = 1 AND p.ts BETWEEN greatest(i.ts - 600, i.prev) AND i.ts), i.ts)) AS lead\n  FROM (SELECT *, lagInFrame(ts, 1, toDateTime(0)) OVER (PARTITION BY host ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS prev FROM incidents) i LEFT JOIN predictions p ON p.host = i.host WHERE $__timeFilter(i.ts) GROUP BY i.ts, i.host)"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Live demo runs 1 tick per second, so 30 s here = 30 simulated minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Events ingested / sec",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT count() / 30 FROM logs WHERE ts BETWEEN now() - 33 AND now() - 3"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Predicted to fail (latest score per host)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT host, argMax(risk, ts) AS risk, argMax(reason, ts) AS reason FROM predictions WHERE ts > now() - 12 GROUP BY host HAVING argMax(alert, ts) = 1 ORDER BY risk DESC"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Failure risk per host",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT ts AS time, host, risk FROM predictions WHERE $__timeFilter(ts) ORDER BY time"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.host}",
          "custom": {
            "insertNulls": 10000
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Memory used",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, avg(mem) AS v FROM metrics WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.host}",
          "custom": {
            "insertNulls": 10000
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Disk used",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, avg(disk) AS v FROM metrics WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.host}",
          "custom": {
            "insertNulls": 10000
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "p99 latency",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, avg(p99_ms) AS v FROM metrics WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.host}",
          "custom": {
            "insertNulls": 10000
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Failures and how early they were predicted",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT i.ts AS failed_at, i.host, i.kind,\n  if(countIf(p.alert = 1 AND p.ts BETWEEN greatest(i.ts - 600, i.prev) AND i.ts) = 0, NULL, dateDiff('second', minIf(p.ts, p.alert = 1 AND p.ts BETWEEN greatest(i.ts - 600, i.prev) AND i.ts), i.ts)) AS warned_min\nFROM (SELECT *, lagInFrame(ts, 1, toDateTime(0)) OVER (PARTITION BY host ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS prev FROM incidents) i LEFT JOIN predictions p ON p.host = i.host WHERE $__timeFilter(i.ts)\nGROUP BY failed_at, i.host, i.kind ORDER BY failed_at DESC"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 10,
        "h": 8
      },
      "description": "Simulated minutes between the first alert (within 10 sim-hours before) and the failure. Empty = no warning."
    },
    {
      "id": 11,
      "title": "Warnings and errors",
      "type": "logs",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 2,
          "rawSql": "SELECT ts AS timestamp, concat(host, '  ', msg) AS body, level FROM logs WHERE $__timeFilter(ts) AND level != 'INFO' ORDER BY ts DESC LIMIT 500"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 20,
        "w": 14,
        "h": 8
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Failures",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "target": {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT ts AS time, concat(host, ' ', kind) AS text FROM incidents WHERE $__timeFilter(ts)"
        }
      }
    ]
  }
}